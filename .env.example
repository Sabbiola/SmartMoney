# SmartMoney Environment Configuration
# Copia questo file come .env e modifica i valori

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/smartmoney"

# JWT Authentication
JWT_SECRET="cambia_questo_con_una_stringa_random_di_64_caratteri"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# App
APP_NAME="SmartMoney"
APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Docker Compose (opzionale)
DB_USER=smartmoney
DB_PASSWORD=smartmoney123
DB_NAME=smartmoney
